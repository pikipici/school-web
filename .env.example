# Development placeholders only. Copy to .env for optional local Compose use.
# Do not reuse these values outside an isolated local development environment.
POSTGRES_ADMIN_USER=monitoring_local_admin
POSTGRES_ADMIN_PASSWORD=dev-only-admin-change-me
POSTGRES_APP_USER=monitoring_app
POSTGRES_APP_PASSWORD=dev-only-app-change-me
POSTGRES_DB=informatika_monitoring
POSTGRES_PORT=54329

# Backend/Goose connection for the optional local database.
DATABASE_URL=postgres://monitoring_app:dev-only-app-change-me@127.0.0.1:54329/informatika_monitoring?sslmode=disable
