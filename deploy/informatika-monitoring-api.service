[Unit]
Description=Informatika Monitoring API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/informatika-monitoring
EnvironmentFile=/home/ubuntu/informatika-monitoring/.env
ExecStart=/home/ubuntu/informatika-monitoring/bin/current/informatika-monitoring-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/informatika-monitoring
UMask=0027

[Install]
WantedBy=multi-user.target
