# Development placeholders only. Copy to backend/.env and replace as needed.
# This file is not loaded automatically by the Go process.
APP_ENV=development
APP_ADDR=:8300
PUBLIC_DIR=../public
DATABASE_URL=postgres://monitoring_app:dev-only-app-change-me@127.0.0.1:54329/informatika_monitoring?sslmode=disable

# Deterministic Goose location when commands are run from backend/:
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://monitoring_app:dev-only-app-change-me@127.0.0.1:54329/informatika_monitoring?sslmode=disable
GOOSE_MIGRATION_DIR=sql/migrations
